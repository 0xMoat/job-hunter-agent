# Test environment — uses local Postgres (same instance as dev), separate DB name
APP_ENV=test
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=jha_test
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=5
JWT_SECRET_KEY=test-secret-do-not-use-in-prod
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=1
GOOGLE_CLIENT_ID=test-client-id.apps.googleusercontent.com
OPENAI_API_KEY=sk-test-fake
DEEPSEEK_API_KEY=sk-test-fake
LANGFUSE_PUBLIC_KEY=pk-lf-test
LANGFUSE_SECRET_KEY=sk-lf-test
# LANGFUSE_HOST intentionally NOT set here — CI's eval-golden job needs the
# real cloud host to come from process env, and config.py's load_dotenv uses
# override=True so any value here clobbers the env. Local `make eval` users
# should export LANGFUSE_HOST themselves (or use .env.development).
DEFAULT_LLM_TEMPERATURE=0.0
MAX_TOKENS=2000
LOG_LEVEL=WARNING
