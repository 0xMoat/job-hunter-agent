<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <title>{{ resume.name_zh }} — 简历</title>
  <style>
    @page { size: A4 portrait; margin: 15mm 20mm; }
    body { font-family: sans-serif; font-size: 10pt; line-height: 1.6; color: #1a1a1a; margin: 0; padding: 0; }
    h1 { font-size: 20pt; margin: 0 0 2mm; }
    h2 { font-size: 11pt; color: #b85c3a; border-bottom: 1px solid #ddd; padding-bottom: 1mm; margin: 5mm 0 3mm; text-transform: uppercase; letter-spacing: 0.05em; }
    h3 { font-size: 10pt; margin: 3mm 0 1mm; }
    .header { text-align: center; margin-bottom: 5mm; }
    .name-en { font-size: 9pt; color: #666; }
    .contact { font-size: 8pt; color: #555; margin-top: 2mm; }
    .contact span { margin: 0 4px; }
    .summary { margin-bottom: 4mm; }
    .skill-group { margin-bottom: 2mm; }
    .skill-group strong { font-size: 9pt; }
    .tag { display: inline-block; background: #f0efea; border: 0.5px solid #ddd; border-radius: 2px; padding: 1px 5px; font-size: 8pt; margin: 1px 2px; }
    .tag.accent { background: #e8c4b5; color: #7a3a22; border-color: #d4967e; }
    .job-header { display: flex; justify-content: space-between; align-items: baseline; }
    .job-period { font-size: 8pt; color: #888; }
    .job-role { font-size: 9pt; color: #b85c3a; margin-bottom: 2mm; }
    .sub-project { margin-left: 4mm; margin-bottom: 2mm; }
    .sub-project h4 { font-size: 9pt; margin: 0 0 1mm; }
    ul { margin: 0; padding-left: 5mm; }
    li { font-size: 9pt; margin-bottom: 1px; }
    .project { margin-bottom: 3mm; }
    .project-header { font-weight: bold; }
    .project-status { font-size: 8pt; color: #888; font-style: italic; }
    .project-desc { font-size: 9pt; color: #555; margin: 1mm 0; }
    .edu { margin-bottom: 2mm; }
    .edu-school { font-weight: bold; }
    .edu-meta { font-size: 8pt; color: #666; }
    .footer { text-align: center; font-size: 7pt; color: #aaa; margin-top: 8mm; border-top: 1px solid #eee; padding-top: 2mm; }
    strong { color: #1a1a1a; }
    code { font-family: monospace; font-size: 8pt; background: #f0efea; padding: 0 3px; border-radius: 2px; }
  </style>
</head>
<body>

  <div class="header">
    <div class="name-en">{{ resume.name_en }}</div>
    <h1>{{ resume.name_zh }}</h1>
    <div style="font-size:10pt;color:#b85c3a;">{{ resume.current_focus }}</div>
    <div class="contact">
      <span>{{ resume.contact.location }}</span> |
      <span>{{ resume.contact.phone }}</span> |
      <span>{{ resume.contact.email }}</span>
      {% if resume.contact.github %} | <span>GitHub: {{ resume.contact.github }}</span>{% endif %}
      {% if resume.contact.linkedin %} | <span>LinkedIn: {{ resume.contact.linkedin }}</span>{% endif %}
    </div>
  </div>

  <h2>个人总结</h2>
  <div class="summary">{{ resume.summary }}</div>

  <h2>核心技能</h2>
  {% for group in resume.skills %}
  <div class="skill-group">
    <strong>{{ group.domain }}：</strong>
    {% for item in group.items %}
    <span class="tag{% if item.accent %} accent{% endif %}">{{ item.name }}</span>
    {% endfor %}
  </div>
  {% endfor %}

  {% if resume.projects %}
  <h2>个人项目</h2>
  {% for proj in resume.projects %}
  <div class="project">
    <span class="project-header">{{ proj.name }}</span>
    <span class="project-status"> — {{ proj.status }}</span>
    {% if proj.url %}<span style="font-size:8pt;"> ({{ proj.url }})</span>{% endif %}
    <div class="project-desc">{{ proj.description }}</div>
    <ul>
      {% for point in proj.points %}
      <li>{{ point | bold_code }}</li>
      {% endfor %}
    </ul>
  </div>
  {% endfor %}
  {% endif %}

  <h2>工作经历</h2>
  {% for job in resume.experience %}
  <div style="margin-bottom:4mm;">
    <div class="job-header">
      <h3 style="margin:0;">{{ job.company }}</h3>
      <span class="job-period">{{ job.dates }}</span>
    </div>
    <div class="job-role">{{ job.role }}</div>
    {% for sp in job.sub_projects %}
    <div class="sub-project">
      <h4>{{ sp.name }}</h4>
      <ul>
        {% for point in sp.points %}
        <li>{{ point | bold_code }}</li>
        {% endfor %}
      </ul>
    </div>
    {% endfor %}
  </div>
  {% endfor %}

  <h2>教育背景</h2>
  {% for edu in resume.education %}
  <div class="edu">
    <span class="edu-school">{{ edu.school }}</span>
    <span class="edu-meta"> — {{ edu.degree }} | {{ edu.dates }}</span>
  </div>
  {% endfor %}

  <div class="footer">Generated by Resume Studio | {{ generated_date }}</div>

</body>
</html>
